APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
GITHUB_TOKEN=
GMAIL_APP_PASSWORD=
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional. Overrides the LinkedIn API host. Used by the end-to-end test to
# point the real publish path at a local server. Leave unset in production.
LINKEDIN_API_BASE_URL=
SMTP_HOST=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_BOT_TOKEN=
# Telegram API host. Leave unset in production. Set only to point the send path
# at a local stand-in during tests.
TELEGRAM_API_BASE_URL=
TELEPHONY_ACCOUNT_ID=
TELEPHONY_AUTH_SECRET=
TELEPHONY_PHONE_NUMBER=
TELEPHONY_PROVIDER=
TELEPHONY_STT_PROVIDER=
TELEPHONY_TTS_PROVIDER=
TELEPHONY_WEBHOOK_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWITTER_ACCESS_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ==============================================================================
# ANDROID MOBILE BRIDGE (real-device link)
# ==============================================================================
# Required to pair a physical Android device. Without it, pairing is disabled
# and the bridge reports NOT_CONFIGURED instead of accepting anonymous devices.
MOBILE_BRIDGE_PAIRING_SECRET=
# Signing secret for bridge session tokens. Falls back to APP_SECRET/SESSION_SECRET.
MOBILE_BRIDGE_SECRET=
# Optional tuning: failed auth attempts per IP per minute before throttling.
MOBILE_BRIDGE_MAX_AUTH_FAILURES=

# ==============================================================================
# COMPUTER OPERATOR (real OS actions)
# ==============================================================================
# Directory for verified screen captures. Defaults to ~/.jarvis/screenshots.
# Captures outside this directory are never reported as verified.
JARVIS_SCREENSHOT_DIR=

# ==============================================================================
# GITHUB / PROJECT AUTOMATION (backlog items 14-24)
# ==============================================================================
# Token used by the repository scanner, health checks and nightly check.
# GITHUB_TOKEN above is used as a fallback if this is unset.
# Required scopes: repo, workflow, read:user.
# Without a token every /api/github/* endpoint reports NOT_CONFIGURED.
GITHUB_AUTOMATION_TOKEN=

# ==============================================================================
# LOCAL LLM FALLBACK (Ollama)
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ==============================================================================
# SUPER-AGENT (multi-provider model router + tool-using agent loop)
# ==============================================================================
# The agent never depends on one vendor. It walks AGENT_PROVIDER_ORDER and the
# first provider that answers wins; a provider that fails is cooled down for
# AGENT_PROVIDER_COOLDOWN_MS so the next task skips it. All of these have a free
# tier, so the agent keeps working at zero cost.
AGENT_PROVIDER_ORDER=gemini,groq,openrouter,cerebras,ollama,deepseek
AGENT_PROVIDER_COOLDOWN_MS=300000
AGENT_REQUEST_TIMEOUT_MS=60000
AGENT_GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
AGENT_GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
AGENT_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
CEREBRAS_API_KEY=
AGENT_CEREBRAS_MODEL=llama-3.3-70b
DEEPSEEK_API_KEY=
AGENT_DEEPSEEK_MODEL=deepseek-chat
# Offline fallback: install Ollama, then `ollama pull qwen2.5-coder:7b`
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AGENT_OLLAMA_MODEL=qwen2.5-coder:7b

# Sandbox for the agent's file and shell tools. Everything is jailed here.
AGENT_WORKSPACE_ROOT=
AGENT_SHELL_TIMEOUT_MS=60000
AGENT_MAX_TOOL_OUTPUT=12000
AGENT_MEMORY_FILE=agent_memory.json
# Optional bearer token for /api/agent/* when the daemon is exposed publicly.
AGENT_API_TOKEN=
# Set true only on a machine you fully trust: lets the agent write files and run
# commands without a per-run approval flag.
AGENT_AUTO_APPROVE=false
