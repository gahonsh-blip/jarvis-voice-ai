TWITTER_ACCESS_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# ==============================================================================
# ANDROID MOBILE BRIDGE (real-device link)
# ==============================================================================
# Required to pair a physical Android device. Without it, pairing is disabled
# and the bridge reports NOT_CONFIGURED instead of accepting anonymous devices.
MOBILE_BRIDGE_PAIRING_SECRET=
# Signing secret for bridge session tokens. Falls back to APP_SECRET/SESSION_SECRET.
MOBILE_BRIDGE_SECRET=
# Optional tuning: failed auth attempts per IP per minute before throttling.
MOBILE_BRIDGE_MAX_AUTH_FAILURES=

# ==============================================================================
# COMPUTER OPERATOR (real OS actions)
# ==============================================================================
# Directory for verified screen captures. Defaults to ~/.jarvis/screenshots.
# Captures outside this directory are never reported as verified.
JARVIS_SCREENSHOT_DIR=

# ==============================================================================
# GITHUB / PROJECT AUTOMATION (backlog items 14-24)
# ==============================================================================
# Token used by the repository scanner, health checks and nightly check.
# GITHUB_TOKEN above is used as a fallback if this is unset.
# Required scopes: repo, workflow, read:user.
# Without a token every /api/github/* endpoint reports NOT_CONFIGURED.
GITHUB_AUTOMATION_TOKEN=

# ==============================================================================
# LOCAL LLM FALLBACK (Ollama)
# ==============================================================================
OLLAMA_BASE_URL=http://127.0.0.1:11434
